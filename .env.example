# Usa una clave de un proyecto de práctica. No compartas este archivo completado.
PINECONE_API_KEY=
# El paso 2 crea este índice si no existe y lo reutiliza si ya existe.
PINECONE_INDEX_NAME=walc-lab-dia-2
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Opcional: host de un índice ya preparado por el instructor.
# Si se indica, tiene prioridad y no se crea un índice por nombre.
PINECONE_INDEX_HOST=
# Un prefijo distinto por grupo, en minúsculas, sin espacios.
PINECONE_NAMESPACE=grupo-01
MODEL=qwen2.5:3b
# Embeddings gestionados por Pinecone Inference.
EMBED_MODEL=multilingual-e5-large
EMBED_DIM=1024
# Desafío: embeddings locales de 768 dimensiones, guardados con pgvector.
# EMBED_LOCAL=embeddinggemma:300m
# EMBED_LOCAL_DIM=768

# PostgreSQL local. Elige una contraseña para este laboratorio.
POSTGRES_PASSWORD=
# URL que abre el participante en su navegador para leer el PDF original.
DOCUMENTOS_URL=http://localhost:8002

# Fecha del caso académico: referencia temporal que recibe el modelo.
FECHA_CONSULTA=2026-10-28
